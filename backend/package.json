    "main": "server.js",
    "type": "commonjs",
    "engines": {
        "node": ">=18"
    },
    "scripts": {
        "start": "node server.js",
        "dev": "node --watch server.js"
    },
    "dependencies": {
        "@vercel/speed-insights": "^2.0.0",
        "cors": "^2.8.5",
        "dotenv": "^17.4.2",
        "express": "^4.19.2",
        "express-rate-limit": "^8.7.0",
        "pg": "^8.23.0"
    },
    "devDependencies": {
        "nodemon": "^3.0.1"
    }
}
